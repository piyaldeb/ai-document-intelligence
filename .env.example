# Copy to .env and adjust. Never commit .env.

# Shared secret between the web app (server-side proxy) and the API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable API authentication (local development only).
API_KEY=change-me

POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel
POSTGRES_DB=docintel

# AI extraction. With a key, Claude extracts fields (schema-constrained output, grounded
# against the source text). Without a key, the deterministic rules extractor is used.
ANTHROPIC_API_KEY=
EXTRACTION_PROVIDER=auto        # auto | anthropic | rules
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium               # low | medium | high

# Throughput knobs
WORKER_CONCURRENCY=2            # documents processed in parallel per worker container
OCR_WORKERS=3                   # parallel Tesseract processes per document
MAX_UPLOAD_MB=100

API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
